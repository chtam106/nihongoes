# Flashcard auth (optional). Production without these stays localStorage-only.

# Mode A - same host (recommended): Vercel rewrites /auth and /api/* to Railway.
NEXT_PUBLIC_AUTH_SAME_ORIGIN=1
# Server-only on Vercel (not NEXT_PUBLIC): Railway service URL, no trailing slash.
# AUTH_BACKEND_INTERNAL_URL=https://nihongoes-backend-production.up.railway.app

# Mode B - split host: public API URL baked into the client bundle.
# NEXT_PUBLIC_API_URL=https://api-stg.nihongoes.com
