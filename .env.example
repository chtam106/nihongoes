# Flashcard auth (optional). Production without these stays localStorage-only.

# Mode A - same host (recommended): Vercel rewrites /auth and /api/* to Fly/Railway.
# On Vercel Preview/stg, AUTH_BACKEND_INTERNAL_URL alone is enough (enables auth + rewrites).
# NEXT_PUBLIC_AUTH_SAME_ORIGIN=1
# Server-only on Vercel (not NEXT_PUBLIC): Fly/Railway URL, no trailing slash.
# AUTH_BACKEND_INTERNAL_URL=https://nihongoes-backend-stg.fly.dev

# Mode B - split host: public API URL baked into the client bundle.
# NEXT_PUBLIC_API_URL=https://api-stg.nihongoes.com
